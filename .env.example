NODE_ENV=development
HOST=127.0.0.1
PORT=8082
TRUST_PROXY=false
STATUS_PUBLIC_ORIGIN=https://status.legacyhosting.xyz
STATUS_COMPONENTS='[{"key":"api","name":"API","url":"https://api.legacyhosting.xyz/health"},{"key":"sso","name":"SSO","url":"https://auth.legacyhosting.xyz/health"},{"key":"panel","name":"Web Panel","url":"https://panel.legacyhosting.xyz/"}]'
STATUS_DATA_FILE=./var/status-snapshot.json
STATUS_EVENTS_FILE=./var/status-events.json
STATUS_PUSH_STATE_FILE=./var/push-state.json
STATUS_PUSH_VAPID_SUBJECT=mailto:status@legacyhosting.xyz
# Generate once with: pnpm push:generate-keys /secure/path/status-vapid.env
# Omit both VAPID keys to disable browser subscriptions outside production.
# STATUS_PUSH_VAPID_PUBLIC_KEY=
# STATUS_PUSH_VAPID_PRIVATE_KEY=
STATUS_PUSH_ALLOWED_HOSTS='["fcm.googleapis.com","updates.push.services.mozilla.com","web.push.apple.com","notify.windows.com"]'
STATUS_POLL_INTERVAL_MS=30000
STATUS_REQUEST_TIMEOUT_MS=5000
STATUS_DEGRADED_AFTER_MS=1500
